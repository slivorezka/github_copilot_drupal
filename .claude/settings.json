{
  "env": {
    "CLAUDE_CODE_HIDE_ACCOUNT_INFO": "1"
  },
  "permissions": {
    "deny": [
      "Bash(**/.env)",
      "Read(**/.env)",
      "Write(**/.env)"
    ]
  },
  "tools": {
    "bash": true,
    "git": true,
    "filesystem": true
  },
  "context": {
    "include": [
      "src/**",
      "web/modules/custom/**",
      "web/themes/custom/**",
      "app/**",
      "config/**",
      "composer.json",
      "package.json",
      "README.md"
    ],
    "exclude": [
      "node_modules/**",
      "vendor/**",
      ".git/**",
      "dist/**",
      "build/**",
      "coverage/**",
      "*.log"
    ]
  },
  "model": "opus",
  "alwaysThinkingEnabled": false
}
